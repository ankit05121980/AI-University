{
  "version": 2,
  "name": "ai-university",
  "public": true,
  "redirects": [
    { "source": "/", "destination": "/web", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
